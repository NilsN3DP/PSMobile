# Externer PrusaSlicer-Checkout - wird per bootstrap.sh geholt
/external/
/core/src/generated/

# Build-Ausgaben
/build-out/
/deps-out/
**/build/
!/build/
/build/*
# Die Skripte unter build/scripts sind Quelltext, keine Bauausgabe.
#
# Hier stand eine Positivliste, in die jedes neue Skript einzeln
# eingetragen werden musste. Das wurde vergessen: dreizehn Skripte lagen
# nur auf der Freigabe, darunter env.sh, bootstrap.sh, build-deps.sh,
# build-apk.sh und extract-ui.py - also die halbe Baukette. Waere die
# Freigabe verloren gegangen, waere sie mit ihr weg gewesen.
!/build/scripts/
!/build/docker/
**/.cxx/
*.o
*.a
*.so
*.apk
*.aab
__pycache__/
*.py[cod]

# Android
android/local.properties
android/.gradle/
android/app/build/
.gradle/

