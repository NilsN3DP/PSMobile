     if (APPLE)
         # Only disable NEON extension for Apple ARM builds, leave it enabled for Raspberry PI.
         set(_disable_neon_extension "-DPNG_ARM_NEON:STRING=off")
@@ -6,7 +6,14 @@ if (MSVC OR APPLE)
