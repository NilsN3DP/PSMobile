diff --git a/CMakeLists.txt b/CMakeLists.txt
index 57b60ea..d3c18fb 100644
--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -56,6 +56,15 @@ set(SLIC3R_GTK "2" CACHE STRING "GTK version to use with wxWidgets on Linux")
 
 set(IS_CROSS_COMPILE FALSE)
 
+# PSMobile: Upstream erkennt Cross-Compiling nur an der Apple-Multi-Arch-
+# Konstellation. Beim Bauen fuer Android setzt die NDK-Toolchain
+# CMAKE_CROSSCOMPILING - ohne diese Zeile versucht der Build, das fuer
+# arm64 uebersetzte Hilfsprogramm encoding-check auf dem x86-Host
+# auszufuehren ("Exec format error").
+if (CMAKE_CROSSCOMPILING)
+    set(IS_CROSS_COMPILE TRUE)
+endif ()
+
 if (SLIC3R_STATIC)
     # Prefer config scripts over find modules. This is helpful when building with
     # the static dependencies. Many libraries have their own export scripts
@@ -439,18 +448,25 @@ slic3r_remap_configs(TBB::tbbmalloc RelWithDebInfo Release)
 # The Intel TBB library will use the std::exception_ptr feature of C++11.
 # add_definitions(-DTBB_USE_CAPTURED_EXCEPTION=0)
 
-find_package(CURL REQUIRED)
-
+# PSMobile: libslic3r enthaelt keine einzige curl-Referenz - Netzwerk
+# steckt ausschliesslich in der Desktop-GUI-Schicht. Ohne GUI brauchen
+# wir weder libcurl noch OpenSSL, was den Android-Cross-Build deutlich
+# verkleinert. Das INTERFACE-Ziel bleibt bestehen, damit Ziele, die
+# darauf verweisen, weiterhin konfigurierbar sind.
 add_library(libcurl INTERFACE)
-target_link_libraries(libcurl INTERFACE CURL::libcurl)
 
-# Fixing curl's cmake config script bugs
-if (NOT WIN32)
-    # Required by libcurl
-    find_package(ZLIB REQUIRED)
-    target_link_libraries(libcurl INTERFACE ZLIB::ZLIB)
-else()
-    target_link_libraries(libcurl INTERFACE crypt32)
+if (SLIC3R_GUI)
+    find_package(CURL REQUIRED)
+    target_link_libraries(libcurl INTERFACE CURL::libcurl)
+
+    # Fixing curl's cmake config script bugs
+    if (NOT WIN32)
+        # Required by libcurl
+        find_package(ZLIB REQUIRED)
+        target_link_libraries(libcurl INTERFACE ZLIB::ZLIB)
+    else()
+        target_link_libraries(libcurl INTERFACE crypt32)
+    endif()
 endif()
 
 ## OPTIONAL packages
@@ -471,16 +487,21 @@ endif ()
 
 find_package(PNG REQUIRED)
 
-set(OpenGL_GL_PREFERENCE "LEGACY")
-find_package(OpenGL REQUIRED)
+# PSMobile: Ohne Desktop-GUI wird weder Desktop-OpenGL noch GLEW
+# gebraucht. Auf Android gibt es beides nicht - dort stellt das System
+# OpenGL ES bereit, und der Viewport bindet GLESv3 direkt ein.
+if (SLIC3R_GUI)
+    set(OpenGL_GL_PREFERENCE "LEGACY")
+    find_package(OpenGL REQUIRED)
 
-# Find glew or use bundled version
-if (SLIC3R_STATIC AND NOT SLIC3R_STATIC_EXCLUDE_GLEW)
-    set(GLEW_USE_STATIC_LIBS ON)
-    set(GLEW_VERBOSE ON)
-endif()
+    # Find glew or use bundled version
+    if (SLIC3R_STATIC AND NOT SLIC3R_STATIC_EXCLUDE_GLEW)
+        set(GLEW_USE_STATIC_LIBS ON)
+        set(GLEW_VERBOSE ON)
+    endif()
 
-find_package(GLEW REQUIRED)
+    find_package(GLEW REQUIRED)
+endif ()
 
 # Find the Cereal serialization library
 find_package(cereal REQUIRED)
diff --git a/deps/+GMP/GMP.cmake b/deps/+GMP/GMP.cmake
index bea8c89..4480366 100644
--- a/deps/+GMP/GMP.cmake
+++ b/deps/+GMP/GMP.cmake
@@ -28,6 +28,11 @@ else ()
     set(_gmp_ccflags "${_stdlib} ${CMAKE_CXX_FLAGS_${_buildtype_upper}} -fPIC -DPIC -Wall -Wmissing-prototypes -Wpointer-arith -pedantic -fomit-frame-pointer -fno-common")
     set(_gmp_build_tgt "${CMAKE_SYSTEM_PROCESSOR}")
 
+    # PSMobile: C- und C++-Flags trennen. -std=gnu11 und -Wmissing-prototypes
+    # sind C-only; clang++ des Android-NDK bricht damit ab.
+    set(_gmp_cxxflags "${CMAKE_CXX_FLAGS_${_buildtype_upper}} -fPIC -DPIC -Wall -Wpointer-arith -fomit-frame-pointer -fno-common")
+
+
     set(_cross_compile_arg "")
     if (APPLE)
         if (CMAKE_OSX_ARCHITECTURES)
@@ -65,7 +70,7 @@ else ()
         URL_HASH SHA256=eae9326beb4158c386e39a356818031bd28f3124cf915f8c5b1dc4c7a36b4d7c
         DOWNLOAD_DIR ${${PROJECT_NAME}_DEP_DOWNLOAD_DIR}/GMP
         BUILD_IN_SOURCE ON 
-        CONFIGURE_COMMAND  env "CFLAGS=${_gmp_ccflags}" "CXXFLAGS=${_gmp_ccflags}" ./configure ${_cross_compile_arg} --enable-shared=no --enable-cxx=yes --enable-static=yes "--prefix=${${PROJECT_NAME}_DEP_INSTALL_PREFIX}" ${_gmp_build_tgt}
+        CONFIGURE_COMMAND  env "CFLAGS=${_gmp_ccflags}" "CXXFLAGS=${_gmp_cxxflags}" ./configure ${_cross_compile_arg} --enable-shared=no --enable-cxx=yes --enable-static=yes "--prefix=${${PROJECT_NAME}_DEP_INSTALL_PREFIX}" ${_gmp_build_tgt}
         BUILD_COMMAND     make -j
         INSTALL_COMMAND   make install
     )
