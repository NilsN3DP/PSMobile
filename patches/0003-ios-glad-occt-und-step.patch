diff --git a/src/libvgcode/glad/src/gles2.c b/src/libvgcode/glad/src/gles2.c
index e9642e9..f0a2af6 100644
--- a/src/libvgcode/glad/src/gles2.c
+++ b/src/libvgcode/glad/src/gles2.c
@@ -761,6 +761,18 @@ static GLADapiproc glad_dlsym_handle(void* handle, const char *name) {
   typedef __eglMustCastToProperFunctionPointerType (GLAD_API_PTR *PFNEGLGETPROCADDRESSPROC)(const char *name);
 #endif
   extern __eglMustCastToProperFunctionPointerType emscripten_GetProcAddress(const char *name);
+#elif GLAD_PLATFORM_APPLE
+  /* iOS kennt kein EGL. Die GLES-Symbole kommen ueber OpenGLES.framework
+     und liegen damit bereits im Prozess - dlsym auf RTLD_DEFAULT findet
+     sie. Deshalb hier nur die Typen nachbilden und den Adressbeschaffer
+     selbst stellen, statt einen EGL-Header zu suchen, den es nicht gibt. */
+  #include <dlfcn.h>
+  typedef void (*__eglMustCastToProperFunctionPointerType)(void);
+  typedef __eglMustCastToProperFunctionPointerType (GLAD_API_PTR *PFNEGLGETPROCADDRESSPROC)(const char *name);
+  static __eglMustCastToProperFunctionPointerType glad_apple_get_proc(const char *name) {
+      return (__eglMustCastToProperFunctionPointerType) dlsym(RTLD_DEFAULT, name);
+  }
+  #define eglGetProcAddress glad_apple_get_proc
 #elif GLAD_GLES2_USE_SYSTEM_EGL
   #include <EGL/egl.h>
   typedef __eglMustCastToProperFunctionPointerType (GLAD_API_PTR *PFNEGLGETPROCADDRESSPROC)(const char *name);
@@ -796,7 +808,9 @@ static void* _glad_GLES2_loader_handle = NULL;
 static void* glad_gles2_dlopen_handle(void) {
 #if GLAD_PLATFORM_EMSCRIPTEN
 #elif GLAD_PLATFORM_APPLE
-    static const char *NAMES[] = {"libGLESv2.dylib"};
+    /* Auf iOS gibt es keine libGLESv2.dylib - das Framework traegt die
+       Symbole. Der alte Name bleibt fuer macOS-Installationen stehen. */
+    static const char *NAMES[] = {"/System/Library/Frameworks/OpenGLES.framework/OpenGLES", "libGLESv2.dylib"};
 #elif GLAD_PLATFORM_WIN32
     static const char *NAMES[] = {"GLESv2.dll", "libGLESv2.dll"};
 #else
